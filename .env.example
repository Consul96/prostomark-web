# ProstoMark — пример переменных окружения (docker-compose env_file: .env)

# --- Core ---
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/prostomark
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change_me
CORS_ORIGINS=http://localhost:5173,http://localhost
STORAGE_PATH=storage
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Модуль «Честный знак» (marking) ---
# Окружение ГИС МТ: sandbox | production
CRPT_ENV=sandbox
# Базовые URL (по умолчанию — песочница). См. docs/marking/crpt-api-mapping.md
CRPT_TRUE_API_BASE_URL=https://markirovka.sandbox.crptech.ru/api/v3/true-api
CRPT_TRUE_API_V4_BASE_URL=https://markirovka.sandbox.crptech.ru/api/v4/true-api
CRPT_SUZ_BASE_URL=https://markirovka.sandbox.crptech.ru
CRPT_NK_BASE_URL=https://апи.национальный-каталог.рф
# Предохранители: продакшн-вызовы запрещены, юридически значимые операции в dry-run отключены
CRPT_ALLOW_PRODUCTION=false
CRPT_DRY_RUN=true
# Зашифрованное хранилище КМ (внутри смонтированного ./storage)
MARKING_STORAGE_PATH=storage/marking
# Ключ AES-GCM (base64-urlsafe 32 байта). ОБЯЗАТЕЛЕН в production.
# Сгенерировать: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MARKING_ENCRYPTION_KEY=
# Sign Agent
SIGN_JOB_TTL_SECONDS=900
SIGN_AGENT_POLL_SECONDS=5
CRPT_HTTP_TIMEOUT=30
